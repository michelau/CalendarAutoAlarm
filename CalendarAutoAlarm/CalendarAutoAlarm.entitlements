<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Time-sensitive notifications break through Focus modes and Do Not Disturb.
         This entitlement does NOT require Apple approval and works for personal
         sideloading with any Apple ID. It replaces the deprecated .timeSensitive
         UNAuthorizationOption (removed from requestAuthorization options). -->
    <key>com.apple.developer.usernotifications.time-sensitive</key>
    <true/>
</dict>
</plist>
